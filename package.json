{
  "name": "kinro-mcp-server",
  "version": "0.3.0",
  "description": "MCP server exposing Kinro insurance capabilities as AI tools",
  "author": "Your Name",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run test:tools",
    "test:tools": "npm run build && ts-node scripts/test-tools.ts",
